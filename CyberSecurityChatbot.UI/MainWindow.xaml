 xaml CyberSecurityChatbot.UI\MainWindow.xaml<Window x:Class="CyberSecurityChatbot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Assistant" Height="700" Width="1000"
        Background="#FF121217" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1E1E2E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4CAF50"/>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel: ASCII art, title, quick info -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#FF9BE79A" TextWrapping="Wrap">
   _____                 _                  
  / ____|               | |                 
 | |     ___  _ __   ___| |__   ___ _ __   
 | |    / _ \| '_ \ / __| '_ \ / _ \ '__|  
 | |___| (_) | | | | (__| | | |  __/ |     
  \_____\___/|_| |_|\___|_| |_|\___|_|
                </TextBlock>

                <TextBlock Text="Cybersecurity Awareness Chatbot" FontSize="16" FontWeight="Bold"
                           Foreground="White" Margin="0,10,0,6"/>

                <TextBlock Text="Tips:" Foreground="LightGray" FontWeight="SemiBold"/>
                <TextBlock Text="• Type questions like 'password' or 'phishing'" Foreground="LightGray" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="• Press Enter to send" Foreground="LightGray" Margin="0,2,0,0"/>
                <Separator Margin="0,8,0,8"/>
                <Button Name="ClearButton" Content="Clear Chat" Click="ClearButton_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Border Grid.Column="1" Background="Transparent"/>

        <!-- Right panel: chat history and input -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat history -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox Name="ChatList" Background="Transparent" BorderThickness="0" />
                </ScrollViewer>
            </Border>

            <!-- Input row -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBox Name="InputBox" MinWidth="480" Height="36" FontSize="14" VerticalContentAlignment="Center"
                         KeyDown="InputBox_KeyDown" />
                <Button Name="SendButton" Content="Send" Click="SendButton_Click" Background="{StaticResource AccentBrush}" Foreground="White"/>
                <Button Name="PhishSimButton" Content="Simulate Phishing" Click="PhishSimButton_Click"/>
            </StackPanel>

            <!-- Password check and status -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <PasswordBox Name="PasswordBox" Width="360" Height="30" />
                <Button Name="CheckPasswordButton" Content="Check Password" Click="CheckPasswordButton_Click"/>
                <TextBlock Name="StatusText" Foreground="LightGray" Margin="12,6,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>