<Window x:Class="CyberSecurityChatbot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Assistant" Height="700" Width="1000"
        Background="#FF0F1113" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1E1E2E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4CAF50"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <!-- Message DataTemplate -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar / bot (left) — replaced Ellipse-with-child with layered Grid -->
                <Grid Grid.Column="0" VerticalAlignment="Top" Width="36" Height="36">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sender}" Value="Bot">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Ellipse Fill="#FF2E8B57" />
                    <TextBlock Text="B" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Bot bubble (left column) -->
                <Border Grid.Column="2" Background="#FF23232B" CornerRadius="8" Padding="10" HorizontalAlignment="Left" MaxWidth="640">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sender}" Value="Bot">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" Foreground="LightGray" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:T}'}" FontSize="10" Foreground="#FF8C8C8C" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- User bubble (right column) -->
                <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="10" HorizontalAlignment="Right" MaxWidth="640">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sender}" Value="You">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" Foreground="Black" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:T}'}" FontSize="10" Foreground="#FF003300" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ListBoxItem style: remove selection, animate fade-in -->
        <Style TargetType="ListBoxItem" x:Key="ChatItemStyle">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#FF9BE79A" TextWrapping="Wrap">
   _____                 _                  
  / ____|               | |                 
 | |     ___  _ __   ___| |__   ___ _ __   
 | |    / _ \| '_ \ / __| '_ \ / _ \ '__|  
 | |___| (_) | | | | (__| | | |  __/ |     
  \_____\___/|_| |_|\___|_| |_|\___|_|
                </TextBlock>

                <TextBlock Text="Cybersecurity Awareness Chatbot" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,10,0,6"/>
                <TextBlock Text="Quick commands:" Foreground="LightGray" FontWeight="SemiBold"/>
                <TextBlock Text="• Ask about password, phishing, privacy, scams" Foreground="LightGray" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="• Press Enter to send. Click 'Simulate Phishing' for demo." Foreground="LightGray" Margin="0,2,0,0"/>
                <Separator Margin="0,8,0,8"/>
                <Button Name="ClearButton" Content="Clear Chat" Click="ClearButton_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Border Grid.Column="1" Background="Transparent"/>

        <!-- Right panel -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat area -->
            <Border Grid.Row="0" Background="#FF0B0B0D" CornerRadius="6" Padding="10">
                <ListBox Name="ChatList" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}"
                         ItemContainerStyle="{StaticResource ChatItemStyle}" Background="Transparent" BorderThickness="0" />
            </Border>

            <!-- Input -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBox Name="InputBox" MinWidth="480" Height="36" FontSize="14" VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown" />
                <Button Name="SendButton" Content="Send" Click="SendButton_Click" Background="{StaticResource AccentBrush}" Foreground="White"/>
                <Button Name="PhishSimButton" Content="Simulate Phishing" Click="PhishSimButton_Click"/>
            </StackPanel>

            <!-- Password check -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <PasswordBox Name="PasswordBox" Width="360" Height="30" />
                <Button Name="CheckPasswordButton" Content="Check Password" Click="CheckPasswordButton_Click"/>
                <TextBlock Name="StatusText" Foreground="LightGray" Margin="12,6,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>